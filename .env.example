# Core app
PORT=3000
APP_ENV=development
APP_URL=http://localhost:3000
TRUSTED_ORIGINS=http://localhost:3000
MAX_FILE_MB=50
MAX_BODY_MB=80
MAX_PROJECT_FILES=30
REQUIRE_LOGIN=true
ALLOW_SELF_SIGNUP=false
TOP_MATCHES_PER_SCOPE=5
JOB_INTERVAL_MS=60000

# Runtime persistence
# local    = data/db.json + data/auth.json
# supabase = normalized PostgreSQL tables are the live source of truth
DATA_BACKEND=local

# OpenAI (optional; local fallback works without it)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# External outreach
AUTO_SEND_INVITES=false
OUTREACH_WEBHOOK_URL=

# Resend email (optional)
RESEND_API_KEY=
EMAIL_FROM=BidMatch AI <onboarding@resend.dev>

# Supabase Postgres + private Storage
SUPABASE_URL=
# Preferred server-side key format in V8. Never expose this in frontend code.
SUPABASE_SECRET_KEY=
# Legacy compatibility only; leave blank for new projects.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=bidmatch-documents

# Stripe subscription billing (optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_SUCCESS_URL=http://localhost:3000/?billing=success
STRIPE_CANCEL_URL=http://localhost:3000/?billing=cancel

# Separate platform admin console (/admin)
# Never commit real hashes/secrets. Use configure-admin.command or deployment environment variables.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD_HASH=
PLATFORM_ADMIN_SESSION_SECRET=
